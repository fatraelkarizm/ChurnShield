        {
          "position": "top",
          "customPositionAndOffsets": {
            "right": 36,
            "width": 22
          },
          "handles": [
            {
              "id": "timeout",
              "label": "Timeout",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.timeLimitEnabled}",
              "labelVisibility": "hover"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "bpmnEngine"
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          {
            "name": "connectorKey",
            "type": "string",
            "value": "uipath-uipath-http"
          },
          {
            "name": "objectName",
            "type": "string",
            "value": "http-request"
          },
          {
            "name": "connection",
            "type": "string",
            "value": "<bindings.uipath-uipath-http connection>"
          },
          {
            "name": "folderKey",
