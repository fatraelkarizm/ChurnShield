    {
      "id": "recommend",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "recommend",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "Kamu adalah analis retensi pelanggan ISP fixed broadband di Indonesia. Gunakan HANYA data pelanggan yang diberikan. Jangan menjanjikan hal yang tidak bisa dijamin (misalnya 'tidak akan ada gangguan lagi'); jangan memakai kata 'dijamin'. Kebijakan penawaran: maksimal diskon 30% selama 3 bulan, ATAU upgrade kecepatan gratis 3 bulan, ATAU 1 bulan gratis untuk pelanggan dengan kontrak <= 1 bulan; kunjungan teknisi prioritas boleh ditambahkan bila ada gangguan jaringan. Pilih satu penawaran yang paling sesuai. Return a result conforming to the output schema. riskSummary: 1-2 kalimat ringkasan risiko. recommendedAction: langkah retensi yang disarankan untuk tim. offer: satu penawaran sesuai kebijakan, spesifik dan singkat. followUpMessage: pesan follow-up ke pelanggan dalam Bahasa Indonesia yang sopan dan hangat, mengakui gangguan yang dialami, menyebut tindak lanjut teknis bila ada tiket, dan menawarkan offer; maksimal 90 kata, tanpa tanda tangan nama orang.",
        "userPrompt": "Nama: {{ $vars.agentContext.output.name }}\nPaket: {{ $vars.agentContext.output.plan }} (Rp {{ $vars.agentContext.output.fee }}/bulan)\nKota: {{ $vars.agentContext.output.city }}\nLama berlangganan: {{ $vars.agentContext.output.tenure }} bulan, sisa kontrak: {{ $vars.agentContext.output.contractLeft }} bulan\nGangguan 30 hari: {{ $vars.agentContext.output.outages }}, packet loss: {{ $vars.agentContext.output.packetLoss }}%, latency: {{ $vars.agentContext.output.latency }} ms\nKeluhan 30 hari: {{ $vars.agentContext.output.complaints }}, keluhan terakhir: {{ $vars.agentContext.output.lastComplaint }}\nTiket lewat SLA: {{ $vars.agentContext.output.ticket }}\nSkor churn: {{ $vars.agentContext.output.score }} ({{ $vars.agentContext.output.level }})\nAlasan: {{ $vars.agentContext.output.reasons }}",
        "model": "anthropic.claude-sonnet-5",
        "mode": "standard",
        "temperature": 1,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "recommend",
        "agentInputVariables": [
          {
            "id": "agentContext__output__name",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.name"
          },
          {
            "id": "agentContext__output__plan",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.plan"
          },
          {
            "id": "agentContext__output__fee",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.fee"
          },
          {
            "id": "agentContext__output__city",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.city"
          },
          {
            "id": "agentContext__output__tenure",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.tenure"
          },
          {
            "id": "agentContext__output__contractLeft",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.contractLeft"
          },
          {
            "id": "agentContext__output__outages",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.outages"
          },
          {
            "id": "agentContext__output__packetLoss",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.packetLoss"
          },
          {
            "id": "agentContext__output__latency",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.latency"
          },
          {
            "id": "agentContext__output__complaints",
            "type": "string",
            "binding": "=js:$vars.agentContext.output.complaints"
          },
          {
