    {
      "id": "retentionReview",
      "type": "uipath.human-in-the-loop",
      "typeVersion": "1.7",
      "display": {
        "label": "retentionReview",
        "icon": "users"
      },
      "inputs": {
        "type": "quick",
        "title": "ChurnShield: review retention offer",
        "priority": "High",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "schema": {
          "schemaId": "1cf6364d-3e9a-50ba-8477-f593ae4f9283",
          "fields": [
            {
              "id": "customer",
              "label": "Pelanggan",
              "type": "string",
              "direction": "input",
              "binding": "=js:$vars.eachCustomer.currentItem.customerCode + \" - \" + $vars.eachCustomer.currentItem.customerName + \" (\" + $vars.eachCustomer.currentItem.servicePlan + \", \" + $vars.eachCustomer.currentItem.city + \")\""
            },
            {
              "id": "churnScore",
              "label": "Skor churn",
              "type": "number",
              "direction": "input",
              "binding": "vars.eachCustomer.currentItem.churnScore"
            },
            {
