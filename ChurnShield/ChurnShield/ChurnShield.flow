                "type": "string",
                "enum": [
                  "single",
                  "multiple"
                ],
                "description": "Whether the node queries one record or a list of records",
                "errorMessage": "Choose whether to query one record or multiple records"
              }
            },
            "required": [
              "entityName"
            ],
            "errorMessage": {
              "required": "An entity must be selected"
            }
          }
        },
        "required": [
          "entityConfig"
        ]
      },
      "inputDefaults": {
        "entityConfig": {
          "resultMode": "single"
        }
      },
