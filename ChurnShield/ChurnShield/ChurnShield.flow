              "type": "string"
            },
            "plan": {
              "type": "string"
            },
            "fee": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "tenure": {
              "type": "string"
            },
            "contractLeft": {
              "type": "string"
            },
            "outages": {
              "type": "string"
            },
            "packetLoss": {
              "type": "string"
            },
            "latency": {
              "type": "string"
            },
            "complaints": {
              "type": "string"
            },
            "lastComplaint": {
              "type": "string"
            },
            "ticket": {
              "type": "string"
            },
            "score": {
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "reasons": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
