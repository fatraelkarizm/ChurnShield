    {
      "id": "policyCheck",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "policyCheck",
        "icon": "code"
      },
      "inputs": {
        "script": "\n  function checkPolicy(offer, message, contractLeft) {\n    const o = String(offer || \"\").toLowerCase();\n    const m = String(message || \"\").toLowerCase();\n    const issues = [];\n    if (o.trim() === \"\") issues.push(\"penawaran kosong\");\n    const pct = (o.match(/[0-9]+ *%/g) || []).map((x) => parseInt(x, 10));\n    pct.forEach((p) => { if (p > 30) issues.push(\"diskon \" + p + \"% melebihi batas 30%\"); });\n    const months = (o.match(/[0-9]+ *bulan/g) || []).map((x) => parseInt(x, 10));\n    months.forEach((n) => { if (n > 3) issues.push(\"durasi \" + n + \" bulan melebihi batas 3 bulan\"); });\n    let hasDiscount = false, hasUpgrade = false, hasFreeMonth = false;\n    o.split(/[+;]| dan | serta |disertai|ditambah|plus /).forEach((part) => {\n      if (part.indexOf(\"upgrade\") >= 0 || part.indexOf(\"kecepatan\") >= 0) { hasUpgrade = true; return; }\n      if (part.indexOf(\"%\") >= 0 || part.indexOf(\"diskon\") >= 0 || part.indexOf(\"potongan\") >= 0) hasDiscount = true;\n      const free = part.match(/gratis *([0-9]+) *bulan|([0-9]+) *bulan *gratis|free *([0-9]+) *month/);\n      if (free) {\n        hasFreeMonth = true;\n        const n = parseInt(free[1] || free[2] || free[3], 10);\n        if (n > 1) issues.push(\"gratis \" + n + \" bulan melebihi batas 1 bulan\");\n        if (Number(contractLeft) > 1) issues.push(\"bulan gratis hanya untuk kontrak <= 1 bulan (sisa kontrak \" + contractLeft + \" bulan)\");\n      }\n    });\n    if ([hasDiscount, hasUpgrade, hasFreeMonth].filter(Boolean).length > 1) issues.push(\"menggabungkan lebih dari satu jenis penawaran\");\n    const banned = [\"dijamin\", \"tidak akan ada gangguan\", \"tidak akan terjadi gangguan\", \"bebas gangguan\", \"pasti stabil\", \"100% stabil\", \"uang kembali\"];\n    banned.forEach((w) => { if (o.indexOf(w) >= 0 || m.indexOf(w) >= 0) issues.push(\"janji yang tidak bisa dijamin: '\" + w + \"'\"); });\n    const words = m.split(\" \").filter((x) => x.trim() !== \"\").length;\n    if (words > 150) issues.push(\"pesan follow-up terlalu panjang (\" + words + \" kata, maks 150)\");\n    return { status: issues.length ? \"Violation\" : \"Compliant\", issues: issues.length ? issues.join(\"; \") : \"sesuai kebijakan\" };\n  }\n\n          return checkPolicy($vars.recommend.output.offer, $vars.recommend.output.followUpMessage,\n            $vars.eachCustomer.currentItem.contractMonthsLeft);\n        "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "status": {
              "type": "string"
            },
            "issues": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "parentId": "eachCustomer",
      "uniqueId": "bb1b21dc-18cf-49c2-a010-5b9717afabbc"
    },
    {
      "id": "markPending",
      "type": "core.datafabric.update",
      "typeVersion": "1.3",
      "display": {
        "label": "markPending",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "CsRetentionCase",
          "recordSource": "byId",
          "recordId": "=js:$vars.openCase.output.Id",
          "fieldUpdates": [
