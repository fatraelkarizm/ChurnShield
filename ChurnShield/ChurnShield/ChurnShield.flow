    {
      "id": "mergeModelScores",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "mergeModelScores",
        "icon": "code"
      },
      "inputs": {
        "script": "\n            const byCode = {};\n            for (const s of ($vars.callModel.output.body.scores || [])) byCode[s.customerCode] = s;\n            let matched = 0;\n            const scored = $vars.scored.map((r) => {\n              const m = byCode[r.customerCode];\n              if (!m) return r;\n              matched++;\n              const score = Math.round(Number(m.churnScore) * 100) / 100;\n              return Object.assign({}, r, {\n                churnScore: score,\n                riskLevel: score >= 0.75 ? \"Very High\" : score >= 0.6 ? \"High\" : score >= 0.35 ? \"Medium\" : \"Low\",\n                reasons: (m.topReasons || []).join(\"; \") || r.reasons\n              });\n            });\n            return { scored: scored, note: \"External model scored \" + matched + \" customers\" };\n          "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "scored": {
              "type": "array"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "b0b236aa-234c-47ee-9711-58691a44b106"
    },
    {
      "id": "prioritize",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "prioritize",
        "icon": "code"
      },
      "inputs": {
        "script": "\n      const threshold = Number($vars.cfgThreshold);\n      const topN = Math.max(0, Math.floor(Number($vars.cfgTopN)));\n      const now = Date.now();\n      const cooldownMs = Math.max(0, Number($vars.cfgCooldownDays)) * 86400000;\n      const slaMs = Math.max(0, Number($vars.cfgSlaHours)) * 3600000;\n      const openStatuses = [\"Analyzing\", \"Pending Approval\", \"Follow-up Ready\"];\n      const cases = $vars.readCases.output.results || [];\n      const blocked = {};\n      const overdue = [];\n      for (const c of cases) {\n        const age = now - new Date(c.CreateTime).getTime();\n        const open = openStatuses.indexOf(c.CaseStatus) >= 0;\n        // a supervisor-rejected offer never reached the customer, so it does not start the contact cooldown\n        const contacted = c.CaseStatus !== \"Closed - Offer Rejected\";\n        if (open || (contacted && age < cooldownMs)) {\n          if (!blocked[c.CustomerCode]) blocked[c.CustomerCode] = open ? \"kasus \" + c.CaseStatus + \" (\" + c.RunId + \")\" : \"sudah ditangani \" + Math.floor(age / 86400000) + \" hari lalu\";\n        }\n        if (c.CaseStatus === \"Pending Approval\" && age >= slaMs && c.ApprovalOverdue !== true) {\n          overdue.push({ id: c.Id, customerCode: c.CustomerCode, customerName: c.CustomerName, runId: c.RunId, hoursWaiting: Math.floor(age / 3600000) });\n        }\n      }\n      const high = $vars.scored.filter((r) => r.churnScore >= threshold);\n      high.sort((a, b) => (b.churnScore * b.revenueAtRisk) - (a.churnScore * a.revenueAtRisk));\n      const eligible = high.filter((r) => !blocked[r.customerCode]);\n      const skipped = high.filter((r) => blocked[r.customerCode]).map((r) => ({ customer: r.customerCode + \" \" + r.customerName, reason: blocked[r.customerCode] }));\n      const top = eligible.slice(0, topN);\n      const total = high.reduce((s, r) => s + r.revenueAtRisk, 0);\n      return { top: top, highRiskCount: high.length, highRiskRevenue: total, scoredCount: $vars.scored.length,\n        skipped: skipped, overdue: overdue };\n    "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "top": {
              "type": "array"
            },
            "highRiskCount": {
              "type": "number"
            },
            "highRiskRevenue": {
              "type": "number"
            },
            "scoredCount": {
              "type": "number"
            },
            "skipped": {
              "type": "array"
            },
            "overdue": {
              "type": "array"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
