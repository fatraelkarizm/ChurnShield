    "variableUpdates": {
      "scoreRules": [
        {
          "variableId": "scored",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.scoreRules.output.scored",
            "fieldType": "array"
          }
        },
        {
          "variableId": "scoringUsed",
          "expression": {
            "type": "jsExpression",
            "expression": "\"rules\"",
            "fieldType": "string"
          }
        }
      ],
      "modelFallback": [
        {
          "variableId": "scoringNote",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.modelFallback.output",
            "fieldType": "string"
          }
        }
      ],
      "mergeModelScores": [
        {
          "variableId": "scored",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.mergeModelScores.output.scored",
            "fieldType": "array"
          }
        },
        {
          "variableId": "scoringUsed",
          "expression": {
            "type": "jsExpression",
            "expression": "\"external\"",
            "fieldType": "string"
          }
        },
        {
          "variableId": "scoringNote",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.mergeModelScores.output.note",
            "fieldType": "string"
          }
        }
      ],
      "start": [
        {
          "variableId": "cfgThreshold",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.riskThreshold",
            "fieldType": "number"
          }
        },
        {
          "variableId": "cfgTopN",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.topN",
            "fieldType": "number"
          }
        },
        {
          "variableId": "cfgMode",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.scoringMode",
            "fieldType": "string"
          }
        },
        {
          "variableId": "cfgModelUrl",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.externalModelUrl",
            "fieldType": "string"
          }
        },
        {
          "variableId": "cfgCooldownDays",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.contactCooldownDays",
            "fieldType": "number"
          }
        },
        {
          "variableId": "cfgSlaHours",
          "expression": {
            "type": "jsExpression",
            "expression": "$vars.start.output.approvalSlaHours",
            "fieldType": "number"
          }
        }
      ]
    }
