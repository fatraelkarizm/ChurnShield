    {
      "id": "buildReport",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "buildReport",
        "icon": "code"
      },
      "inputs": {
        "script": "\n      const cases = $vars.readRunCases.output.results || [];\n      const p = $vars.prioritize.output;\n      const approved = cases.filter((c) => c.Decision === \"Approved\" || c.Decision === \"Approved (Exception)\");\n      const exceptions = cases.filter((c) => c.Decision === \"Approved (Exception)\");\n      const rejected = cases.filter((c) => c.Decision === \"Rejected by Supervisor\");\n      const noAction = cases.filter((c) => c.Decision === \"No Action\");\n      const escalated = cases.filter((c) => c.TicketEscalated === true);\n      const aiFlagged = cases.filter((c) => c.PolicyStatus !== \"Compliant\");\n      const protectedRevenue = approved.reduce((s, c) => s + Number(c.RevenueAtRisk || 0), 0);\n      const rp = (n) => \"Rp \" + String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\");\n      const summary = \"ChurnShield \" + $vars.newRun.output + \": \" + p.scoredCount + \" pelanggan dinilai (\" +\n        $vars.scoringUsed + \"), \" + p.highRiskCount + \" berisiko tinggi dengan revenue at risk \" + rp(p.highRiskRevenue) +\n        \"/tahun. \" + cases.length + \" kasus baru diproses: \" + escalated.length + \" tiket dieskalasi, \" + approved.length +\n        \" penawaran disetujui (\" + rp(protectedRevenue) + \"/tahun dilindungi\" +\n        (exceptions.length ? \", \" + exceptions.length + \" lewat pengecualian supervisor\" : \"\") + \"), \" +\n        (rejected.length ? rejected.length + \" ditolak supervisor, \" : \"\") + noAction.length + \" tanpa tindakan.\" +\n        (p.skipped.length ? \" \" + p.skipped.length + \" pelanggan berisiko dilewati karena sudah punya kasus atau masih masa jeda kontak.\" : \"\") +\n        (p.overdue.length ? \" \" + p.overdue.length + \" approval lewat SLA \" + $vars.cfgSlaHours + \" jam ditandai untuk supervisor.\" : \"\") +\n        ($vars.scoringNote ? \" Catatan: \" + $vars.scoringNote + \".\" : \"\");\n      return {\n        summary: summary,\n        report: {\n          runId: $vars.newRun.output, scoringMode: $vars.scoringUsed, scoringNote: $vars.scoringNote,\n          customersScored: p.scoredCount, openTickets: $vars.buildFeatures.output.openTicketCount,\n          highRiskCount: p.highRiskCount, revenueAtRisk: p.highRiskRevenue,\n          casesProcessed: cases.length, ticketsEscalated: escalated.length,\n          offersApproved: approved.length, policyExceptions: exceptions.length, rejectedBySupervisor: rejected.length,\n          noAction: noAction.length, revenueProtected: protectedRevenue, policyNotCompliantAtClose: aiFlagged.length,\n          skippedExistingCase: p.skipped, approvalsOverdue: p.overdue,\n          cases: cases.map((c) => ({\n            customer: c.CustomerCode + \" \" + c.CustomerName, churnScore: c.ChurnScore, riskLevel: c.RiskLevel,\n            revenueAtRisk: c.RevenueAtRisk, ticketEscalated: c.TicketEscalated, decision: c.Decision,\n            status: c.CaseStatus, offer: c.OfferDetail, policy: c.PolicyStatus, policyIssues: c.PolicyIssues\n          }))\n        }\n      };\n    "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "summary": {
              "type": "string"
            },
            "report": {
              "type": "object"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "d11a290a-213f-4384-b9e8-07e02d6c5357"
