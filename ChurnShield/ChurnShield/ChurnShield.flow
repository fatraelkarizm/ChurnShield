        }
      },
      "form": {
        "id": "create-entity-properties",
        "title": "Create entity record configuration",
        "sections": [
          {
            "id": "entity-config",
            "title": "Entity configuration",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.entityConfig",
