    {
      "id": "ingest",
      "type": "core.logic.merge",
      "typeVersion": "1.1",
      "display": {
        "label": "ingest",
        "icon": "merge"
      },
      "inputs": {},
      "uniqueId": "7c846533-7200-4f7e-80cf-e33f8177e3c4"
    },
    {
      "id": "buildFeatures",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "buildFeatures",
        "icon": "code"
      },
      "inputs": {
        "script": "\n      const customers = $vars.readCustomers.output.results || [];\n      const tickets = $vars.readTickets.output.results || [];\n      const now = Date.now();\n      const byCustomer = {};\n      for (const t of tickets) {\n        const hoursOpen = (now - new Date(t.OpenedAt).getTime()) / 3600000;\n        const overdueBy = hoursOpen - Number(t.SlaHours || 0);\n        const row = { id: t.Id, code: t.TicketCode, category: t.Category, overdueBy: overdueBy };\n        (byCustomer[t.CustomerCode] = byCustomer[t.CustomerCode] || []).push(row);\n      }\n      const features = customers.map((c) => {\n        const open = byCustomer[c.CustomerCode] || [];\n        const overdue = open.filter((t) => t.overdueBy > 0).sort((x, y) => y.overdueBy - x.overdueBy);\n        const worst = overdue[0];\n        return {\n          customerCode: c.CustomerCode, customerName: c.CustomerName, servicePlan: c.ServicePlan,\n          monthlyFee: Number(c.MonthlyFee || 0), city: c.City, contactEmail: c.ContactEmail,\n          tenureMonths: Number(c.TenureMonths || 0), contractMonthsLeft: Number(c.ContractMonthsLeft || 0),\n          outages30d: Number(c.Outages30d || 0), avgPacketLoss: Number(c.AvgPacketLoss || 0),\n          avgLatencyMs: Number(c.AvgLatencyMs || 0), complaints30d: Number(c.Complaints30d || 0),\n          lastComplaint: c.LastComplaint || \"\",\n          openTickets: open.length, overdueTickets: overdue.length,\n          overdueTicketId: worst ? worst.id : \"\", overdueTicketCode: worst ? worst.code : \"\",\n          overdueTicketCategory: worst ? worst.category : \"\",\n          hoursOverdue: worst ? Math.round(worst.overdueBy) : 0,\n          revenueAtRisk: Number(c.MonthlyFee || 0) * 12\n        };\n      });\n      return { features: features, customerCount: features.length, openTicketCount: tickets.length };\n    "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "features": {
              "type": "array"
            },
            "customerCount": {
              "type": "number"
            },
            "openTicketCount": {
              "type": "number"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "14b4069f-6de7-476e-97c6-e7b20f635aea"
    },
    {
      "id": "scoreRules",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "scoreRules",
        "icon": "code"
      },
      "inputs": {
        "script": "\n      const negative = [\"pindah provider\", \"kecewa\", \"putus\", \"berhenti\", \"lag\", \"terganggu\"];\n      const scored = $vars.buildFeatures.output.features.map((f) => {\n        const reasons = [];\n        let s = 0;\n        const add = (w, why) => { if (w > 0) { s += w; reasons.push(why); } };\n        add(Math.min(f.outages30d / 6, 1) * 0.25, f.outages30d + \" gangguan dalam 30 hari\");\n        add(Math.min(f.avgPacketLoss / 5, 1) * 0.15 * (f.avgPacketLoss >= 2 ? 1 : 0), \"packet loss rata-rata \" + f.avgPacketLoss + \"%\");\n        add(Math.min(Math.max(f.avgLatencyMs - 60, 0) / 150, 1) * 0.10, \"latency rata-rata \" + f.avgLatencyMs + \" ms\");\n        add(Math.min(f.complaints30d / 4, 1) * 0.15 * (f.complaints30d >= 2 ? 1 : 0), f.complaints30d + \" keluhan dalam 30 hari\");\n        const text = String(f.lastComplaint).toLowerCase();\n        if (negative.some((w) => text.indexOf(w) >= 0)) add(0.10, \"keluhan bernada negatif: \\\"\" + f.lastComplaint + \"\\\"\");\n        if (f.overdueTickets > 0) add(0.15, \"tiket \" + f.overdueTicketCode + \" lewat SLA \" + f.hoursOverdue + \" jam\");\n        if (f.contractMonthsLeft <= 0) add(0.10, \"kontrak sudah habis bulan ini\");\n        else if (f.contractMonthsLeft <= 1) add(0.10, \"kontrak habis dalam 1 bulan\");\n        else if (f.contractMonthsLeft <= 3) add(0.05, \"kontrak habis dalam \" + f.contractMonthsLeft + \" bulan\");\n        if (f.tenureMonths < 6) add(0.05, \"pelanggan baru (\" + f.tenureMonths + \" bulan)\");\n        const score = Math.round(Math.min(s, 1) * 100) / 100;\n        return Object.assign({}, f, {\n          churnScore: score,\n          riskLevel: score >= 0.75 ? \"Very High\" : score >= 0.6 ? \"High\" : score >= 0.35 ? \"Medium\" : \"Low\",\n          reasons: reasons.length ? reasons.join(\"; \") : \"tidak ada sinyal risiko signifikan\"\n        });\n      });\n      return { scored: scored };\n    "
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "scored": {
              "type": "array"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "651ff0ff-0021-4c19-8b12-609c4f9fc582"
    },
