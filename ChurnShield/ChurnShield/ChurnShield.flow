            "type": "string"
          }
        ],
        "source": "dde85ea2-ea1d-4750-9be2-225eb24a7110",
        "modelSkipsTemperature": true
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
