{
  "id": "f10cb1af-e962-41ad-aba8-40d250ac2453",
  "version": "1.9",
  "name": "ChurnShield",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "09d4f06e-0102-4000-8000-08d6b8c20102",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "uniqueId": "5594d5a2-649d-4b80-8ca1-bf502d14698e"
    },
    {
      "id": "newRun",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "newRun",
        "icon": "code"
      },
      "inputs": {
        "script": "\n      const d = new Date();\n      const p = (n) => String(n).padStart(2, \"0\");\n      return \"RUN-\" + d.getUTCFullYear() + p(d.getUTCMonth() + 1) + p(d.getUTCDate()) + \"-\" +\n        p(d.getUTCHours()) + p(d.getUTCMinutes()) + p(d.getUTCSeconds());\n    "
      },
      "outputs": {
        "output": {
          "type": "string",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "7db33190-b8cf-43ad-8e78-a0f016862a2d"
    },
    {
      "id": "readCustomers",
      "type": "core.datafabric.read",
      "typeVersion": "1.4",
      "display": {
        "label": "readCustomers",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "CsCustomer",
          "resultMode": "multiple",
          "_recordLimit": 1000,
          "_sort": {
            "field": "CustomerCode",
            "direction": "asc"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record queried by this node, or the matching records under \"results\"",
          "source": "=response",
          "var": "output"
        }
      },
      "uniqueId": "a93db4a9-e491-4c23-a3cc-3726f81177e3"
    },
    {
      "id": "readTickets",
      "type": "core.datafabric.read",
      "typeVersion": "1.4",
      "display": {
        "label": "readTickets",
        "icon": "layers-arrow-up-right"
      },
      "inputs": {
        "entityConfig": {
          "entityName": "CsTicket",
          "resultMode": "multiple",
          "_recordLimit": 1000,
          "_sort": {
            "field": "OpenedAt",
            "direction": "asc"
          },
          "_filters": [
            {
              "field": "TicketStatus",
              "operator": "=",
              "value": "Open"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "jsonSchema",
          "description": "Entity record queried by this node, or the matching records under \"results\"",
          "source": "=response",
          "var": "output"
        }
      },
      "uniqueId": "0753af52-a2d1-4390-abe1-baeb2dc4f25b"
    },
    {
      "id": "readCases",
